{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "family-birthdays",
  "compatibility_date": "2026-10-23",
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application"
  },
  // Required by `wrangler preview`, which Workers Builds runs for non-main branches.
  "previews": {},
  // Public (anyone can create a family) deployment, selected by CLOUDFLARE_ENV in .env.public.
  "env": {
    "public": {
      "name": "family-birthdays-public"
    }
  }
}
